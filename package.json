{
  "name": "dsh-cache-guard",
  "version": "0.2.0",
  "description": "Host- and agent-layer DeepSeek Harness plugin that prices every automatic context rewrite before it lands, asks the human by default, and reports what the provider had to re-read cold.",
  "author": "loonylabs-dev <info@loonylabs.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loonylabs-dev/dsh-cache-guard.git"
  },
  "bugs": {
    "url": "https://github.com/loonylabs-dev/dsh-cache-guard/issues"
  },
  "homepage": "https://github.com/loonylabs-dev/dsh-cache-guard#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "compaction",
    "pruning",
    "prefix-cache",
    "cost"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./engine": "./engine.js",
    "./client": "./client.js",
    "./lib/cold-cost": "./lib/cold-cost.js",
    "./lib/preset-file": "./lib/preset-file.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "engine.js",
    "client.js",
    "lib",
    "tools",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test test/imports.test.mjs test/cold-cost.test.mjs test/plan.test.mjs test/gate.test.mjs test/routes.test.mjs test/client.test.mjs",
    "test:integration": "node --test test/real-engine.test.mjs test/preset-composition.test.mjs",
    "install:profile": "node tools/install-profile.mjs",
    "simulate": "node tools/simulate-session.mjs",
    "prepublishOnly": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-group": "^1.0.1",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-compaction-basic": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-token-meter": "^0.1.0-rc.7"
  },
  "engines": {
    "node": ">=22"
  }
}
